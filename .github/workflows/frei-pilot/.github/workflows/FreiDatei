name: ATLAS F1F v4.1 causal observer (manual only)
on:
  workflow_dispatch:
permissions:
  contents: read
jobs:
  diagnose:
    runs-on: ubuntu-latest
    timeout-minutes: 15
    steps:
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065
        with:
          python-version: '3.12'
      - name: Install pinned SDK and record dependency tree
        run: |
          python -m pip install 'git+https://github.com/openai/openai-agents-python.git@e355d69152d4f4730dfb03b63dbce53e8d9f5d8c'
          python -m pip show openai-agents > sdk.txt
          python -m pip freeze > dependencies.txt
      - name: Causal observation (no patch, no external API)
        shell: bash
        run: |
          set -euo pipefail
          mkdir -p proof
          cat > probe.py <<'ATLAS_F1F_V4_PROBE'
          """ATLAS F1F v4: single-process, synthetic OpenAI Agents SDK partial-approval diagnostic.
          
          Only ScriptedModel and harmless in-memory counters are used. No OpenAI API calls.
          Hypothesis and measurements are deliberately separated. Python 3.12.
          """
          from __future__ import annotations
          
          import asyncio
          import hashlib
          import importlib
          import importlib.metadata
          import json
          import platform
          import subprocess
          import sys
          import threading
          import traceback
          from pathlib import Path
          from typing import Any
          
          BASELINE = "e355d69152d4f4730dfb03b63dbce53e8d9f5d8c"
          CASES = ("DIRECT_REJECT", "NESTED_REJECT", "NESTED_NO_DECISION")
          ROOT = Path("proof")
          ROOT.mkdir(exist_ok=True)
          WATCHED = {
              "_run_agent_impl", "_nested_interruptions_status",
              "_function_output_exists", "resolve_interrupted_turn",
              "_select_function_tool_runs_for_resume", "execute_function_tool_calls",
          }
          LOCAL_TARGETS = {"_nested_interruptions_status", "_function_output_exists"}
          
          
          def save_json(name: str, obj: Any) -> None:
              (ROOT / name).write_text(json.dumps(obj, indent=2, sort_keys=True, default=str) + "\n")
          
          
          def runtime_identity() -> dict:
              """Identify the loaded modules rather than trusting a pip command in the workflow."""
              dist = importlib.metadata.distribution("openai-agents")
              origin = json.loads(dist.read_text("direct_url.json") or "{}")
              modules = {}
              for label, name in (
                  ("agent", "agents.agent"),
                  ("turn_resolution", "agents.run_internal.turn_resolution"),
                  ("tool_planning", "agents.run_internal.tool_planning"),
              ):
                  module = importlib.import_module(name)
                  path = Path(module.__file__).resolve()
                  modules[label] = {"path": str(path), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
              actual = origin.get("vcs_info", {}).get("commit_id")
              return {"python": platform.python_version(), "package_version": dist.version,
                      "expected_commit": BASELINE, "actual_commit": actual,
                      "commit_match": actual == BASELINE, "modules": modules}
          
          
          def trace_valid(record: dict, phase: str) -> bool:
              rows = record.get("events", [])
              section = [r for r in rows if r.get("phase") == phase]
              starts = [r for r in section if r.get("event") == "TRACE_START"]
              ends = [r for r in section if r.get("event") == "TRACE_END"]
              if len(starts) != 1 or len(ends) != 1:
                  return False
              start, end = starts[0], ends[0]
              return bool(
                  start["seq"] < end["seq"]
                  and [e["seq"] for e in rows] == list(range(1, len(rows) + 1))
                  and start.get("observer_active") is True
                  and end.get("observer_active") is True
                  and end.get("same_thread") is True
                  and end.get("observer_errors") == 0
                  and end.get("dropped_events") == 0
                  and end.get("unmatched_sync_calls") == 0
                  and end.get("reason") == "returned"
              )
          
          
          def observer_selftest() -> dict:
              """Probe Python profiling behavior in a separate child process."""
              child_code = '''
          import sys
          seen=[]
          def cb(frame,event,value):
              if frame.f_code.co_name in ("status_value","boolean_value","throws"):
                  seen.append((frame.f_code.co_name,event,value))
          def status_value(): return "pending"
          def boolean_value(): return True
          def throws(): raise ValueError("test")
          sys.setprofile(cb)
          try:
              status_value(); boolean_value()
              try: throws()
              except ValueError: pass
          finally:
              sys.setprofile(None)
          assert ("status_value", "return", "pending") in seen
          assert ("boolean_value", "return", True) in seen
          assert ("throws", "return", None) in seen
          def stimulus(): pass
          def faulty(frame,event,value):
              if event == "call" and frame.f_code.co_name == "stimulus":
                  raise RuntimeError("profiler failure")
          sys.setprofile(faulty)
          try:
              try: stimulus()
              except RuntimeError: pass
              assert sys.getprofile() is None
          finally:
              sys.setprofile(None)
          '''
              run = subprocess.run([sys.executable, "-c", child_code], text=True,
                                   capture_output=True, timeout=15)
              if run.returncode:
                  raise RuntimeError("observer selftest failed: " + run.stderr[-1000:])
              valid = {"events": [
                  {"phase": "check", "seq": 1, "event": "TRACE_START", "observer_active": True},
                  {"phase": "check", "seq": 2, "event": "TRACE_END", "observer_active": True,
                   "same_thread": True, "observer_errors": 0, "dropped_events": 0,
                   "unmatched_sync_calls": 0, "reason": "returned"},
              ]}
              assert trace_valid(valid, "check")
              assert not trace_valid({"events": valid["events"][:-1]}, "check")
              altered = {"events": [valid["events"][0], dict(valid["events"][1], observer_errors=1)]}
              assert not trace_valid(altered, "check")
              altered2 = {"events": [valid["events"][0], dict(valid["events"][1], dropped_events=1)]}
              assert not trace_valid(altered2, "check")
              # A valid-looking causal chain must be rejected if its parent invocation
              # or logical parent call ID is mismatched.
              chain = {"events": [
                  {"phase": "RESUME_A", "seq": 1, "event": "TRACE_START", "observer_active": True},
                  {"phase": "RESUME_A", "seq": 2, "event": "APPROVAL_READ", "call_id": "inner-A",
                   "caller_function": "_nested_interruptions_status", "caller_invocation": 8,
                   "decision": True, "return_type": "bool"},
                  {"phase": "RESUME_A", "seq": 3, "event": "APPROVAL_READ", "call_id": "inner-B",
                   "caller_function": "_nested_interruptions_status", "caller_invocation": 8,
                   "decision": None, "return_type": "NoneType"},
                  {"phase": "RESUME_A", "seq": 4, "event": "LOCAL_RETURN",
                   "function": "_nested_interruptions_status", "call_id": "outer-1",
                   "invocation": 8, "regular_value": True, "value": "pending", "parent_invocation": 9},
                  {"phase": "RESUME_A", "seq": 5, "event": "LOCAL_RETURN",
                   "function": "_function_output_exists", "call_id": "outer-1",
                   "regular_value": True, "value": True, "invocation": 9},
                  {"phase": "RESUME_A", "seq": 6, "event": "SELECTION_RESULT",
                   "candidate_call_ids": ["outer-1"], "selected_call_ids": []},
                  {"phase": "RESUME_A", "seq": 7, "event": "TRACE_END",
                   "observer_active": True, "same_thread": True, "observer_errors": 0,
                   "dropped_events": 0, "unmatched_sync_calls": 0, "reason": "returned"},
              ], "after_A": {"counts": {"effect_A": 0}}}
              # The exact selector identity and actual outer-output inventory must agree.
              chain["events"].insert(1, {
                  "phase": "RESUME_A", "event": "SELECTOR_ENTER",
                  "selector_frame_id": "selector-test", "candidate_call_ids": ["outer-1"]})
              chain["events"].insert(2, {
                  "phase": "RESUME_A", "event": "OUTER_OUTPUT_INDEX",
                  "selector_frame_id": "selector-test", "invocation": 9,
                  "call_id": "outer-1", "index_known": True,
                  "actual_output_item_present": False})
              for event in chain["events"]:
                  if event.get("event") == "LOCAL_RETURN" and event.get("function") == "_function_output_exists":
                      event["selector_frame_id"] = "selector-test"
                  if event.get("event") == "SELECTION_RESULT":
                      event["selector_frame_id"] = "selector-test"
              for i, event in enumerate(chain["events"], 1):
                  event["seq"] = i
              assert cause_chain(chain)["status"] == "SUPPORTED"
              bad_parent = {**chain, "events": [dict(e) for e in chain["events"]]}
              bad_parent["events"][6]["invocation"] = 10
              assert cause_chain(bad_parent)["status"] == "UNRESOLVED"
              bad_call = {**chain, "events": [dict(e) for e in chain["events"]]}
              bad_call["events"][6]["call_id"] = "different-parent"
              assert cause_chain(bad_call)["status"] == "UNRESOLVED"
              # A selector for a different call must never prove that outer-1 was excluded.
              bad_candidates = {**chain, "events": [dict(e) for e in chain["events"]]}
              bad_candidates["events"][7]["candidate_call_ids"] = ["inner-A", "inner-B"]
              assert cause_chain(bad_candidates)["status"] == "UNRESOLVED"
              bad_approval = {**chain, "events": [dict(e) for e in chain["events"]]}
              bad_approval["events"][4]["decision"] = False
              assert cause_chain(bad_approval)["status"] == "UNRESOLVED"
              bad_read_owner = {**chain, "events": [dict(e) for e in chain["events"]]}
              bad_read_owner["events"][3]["caller_invocation"] = 777
              assert cause_chain(bad_read_owner)["status"] == "UNRESOLVED"
              bad_inventory = {**chain, "events": [dict(e) for e in chain["events"]]}
              bad_inventory["events"][2]["actual_output_item_present"] = True
              assert cause_chain(bad_inventory)["status"] == "UNRESOLVED"
              bad_selector = {**chain, "events": [dict(e) for e in chain["events"]]}
              bad_selector["events"][7]["selector_frame_id"] = "other-selector"
              assert cause_chain(bad_selector)["status"] == "UNRESOLVED"
              return {"return_types": "PASS", "exception_return_not_conflated": "PASS",
                      "profiler_disable_detected": "PASS", "missing_trace_end_rejected": "PASS",
                      "observer_error_rejected": "PASS", "drop_rejected": "PASS",
                      "valid_causal_chain_accepted": "PASS", "wrong_parent_rejected": "PASS",
                      "wrong_call_rejected": "PASS", "wrong_candidate_rejected": "PASS",
                      "incorrect_B_read_rejected": "PASS", "wrong_gate_read_rejected": "PASS",
                      "real_output_rejected": "PASS", "different_selector_rejected": "PASS"}
          
          
          class Observer:
              def __init__(self, case: str, record: dict):
                  self.case = case
                  self.record = record
                  self.events = record["events"]
                  self.phase = "INIT"
                  self.errors: list[str] = []
                  self.dropped = 0
                  self.active_frames: dict[int, dict] = {}
                  self.seen_selector_frames: set[int] = set()
                  self.next_invocation = 0
          
              def emit(self, event: str, **fields: Any) -> None:
                  if len(self.events) >= 16000:
                      self.dropped += 1
                      return
                  self.events.append({"seq": len(self.events) + 1, "case": self.case,
                                      "phase": self.phase, "event": event, **fields})
          
              def profile(self, frame, event, value):
                  try:
                      path = frame.f_code.co_filename.replace(chr(92), "/")
                      if "/agents/" not in path:
                          return
                      name = frame.f_code.co_name
                      if name not in WATCHED and name not in ("get_approval_status", "run"):
                          return
                      loc = frame.f_locals
                      if event == "call":
                          if name == "_select_function_tool_runs_for_resume":
                              selector_id = id(frame)
                              if selector_id not in self.seen_selector_frames:
                                  self.seen_selector_frames.add(selector_id)
                                  candidates = loc.get("runs")
                                  if not isinstance(candidates, (list, tuple)):
                                      self.errors.append("SELECTOR_ENTER_NO_CANDIDATES")
                                  else:
                                      self.emit("SELECTOR_ENTER", selector_frame_id=selector_id,
                                                candidate_call_ids=[
                                                    getattr(getattr(x, "tool_call", None), "call_id", None)
                                                    for x in candidates])
                          if name in WATCHED:
                              self.emit("ENTER", function=name,
                                        module=path.rsplit("/", 1)[-1],
                                        qualname=frame.f_code.co_qualname)
                          if name in LOCAL_TARGETS:
                              caller = frame.f_back
                              run = (loc.get("run") if name == "_function_output_exists"
                                     else caller.f_locals.get("run") if caller else None)
                              call_id = getattr(getattr(run, "tool_call", None), "call_id", None)
                              parent = (self.active_frames.get(id(caller), {}).get("invocation")
                                        if name == "_nested_interruptions_status" and caller else None)
                              self.next_invocation += 1
                              num = self.next_invocation
                              selector_id = id(caller) if name == "_function_output_exists" and caller else None
                              self.active_frames[id(frame)] = {"invocation": num, "parent": parent,
                                                               "call_id": call_id,
                                                               "selector_frame_id": selector_id}
                              self.emit("LOCAL_ENTER", function=name, invocation=num,
                                        parent_invocation=parent, call_id=call_id,
                                        selector_frame_id=selector_id,
                                        source_path=path, qualname=frame.f_code.co_qualname,
                                        thread_id=threading.get_ident())
                              if name == "_function_output_exists":
                                  resolution_frame = caller.f_back if caller else None
                                  output_index = (resolution_frame.f_locals.get("output_index")
                                                  if resolution_frame else None)
                                  index_known = isinstance(output_index, (dict, set))
                                  if not index_known:
                                      self.errors.append("OUTPUT_INDEX_NOT_OBSERVABLE")
                                  self.emit("OUTER_OUTPUT_INDEX", invocation=num,
                                            call_id=call_id, selector_frame_id=selector_id,
                                            index_known=index_known,
                                            actual_output_item_present=(
                                                ("function_call_output", call_id) in output_index
                                                if index_known else None))
                              if call_id is None:
                                  self.errors.append("MISSING_CALL_ID:" + name)
                              if name == "_nested_interruptions_status" and parent is None:
                                  self.errors.append("MISSING_PARENT_INVOCATION")
                          if name == "run" and path.endswith("/agents/run.py"):
                              self.emit("RUNNER_ENTER",
                                        agent=getattr(loc.get("starting_agent"), "name", None),
                                        input_is_state=type(loc.get("input")).__name__ == "RunState")
                      elif event == "return":
                          if name in LOCAL_TARGETS:
                              prior = self.active_frames.pop(id(frame), None)
                              if prior is None:
                                  self.errors.append("UNMATCHED_RETURN:" + name)
                              else:
                                  regular = (type(value) is bool if name == "_function_output_exists"
                                             else type(value) is str and value in
                                                  ("approved", "pending", "rejected"))
                                  self.emit("LOCAL_RETURN", function=name,
                                            invocation=prior["invocation"],
                                            parent_invocation=prior["parent"],
                                            call_id=prior["call_id"],
                                            selector_frame_id=prior["selector_frame_id"],
                                            regular_value=regular, return_type=type(value).__name__,
                                            value=value if regular else None)
                          if name == "_select_function_tool_runs_for_resume" and type(value) is list:
                              candidates = loc.get("runs")
                              if not isinstance(candidates, (list, tuple)):
                                  self.errors.append("SELECTION_CANDIDATES_MISSING")
                              else:
                                  self.emit("SELECTION_RESULT", selector_frame_id=id(frame),
                                        candidate_call_ids=[
                                      getattr(getattr(x, "tool_call", None), "call_id", None) for x in candidates],
                                      selected_call_ids=[
                                      getattr(getattr(x, "tool_call", None), "call_id", None) for x in value])
                          if name == "get_approval_status" and loc.get("call_id") in ("inner-A", "inner-B"):
                              caller = frame.f_back
                              pending = loc.get("existing_pending") or loc.get("current_invocation")
                              self.emit("APPROVAL_READ", call_id=loc.get("call_id"),
                                        tool=loc.get("tool_name"), namespace=loc.get("tool_namespace"),
                                        owning_agent=getattr(getattr(pending, "agent", None), "name", None),
                                        caller_function=caller.f_code.co_name if caller else None,
                                        caller_invocation=(self.active_frames.get(id(caller), {}).get("invocation")
                                                           if caller else None), decision=value,
                                        return_type=type(value).__name__)
                  except BaseException as error:
                      # Never allow an observer error to masquerade as missing SDK execution.
                      self.errors.append("PROFILE_CALLBACK_ERROR:" + type(error).__name__)
          
              async def resume(self, agent, state, phase, run_config):
                  from agents import Runner
                  self.phase = phase
                  self.seen_selector_frames.clear()
                  previous = sys.getprofile()
                  start_thread = threading.get_ident()
                  errors_before = len(self.errors)
                  dropped_before = self.dropped
                  self.emit("ROOT_RESUME_REQUESTED", agent=agent.name)
                  sys.setprofile(self.profile)
                  started = sys.getprofile() == self.profile
                  self.emit("TRACE_START", observer_active=started,
                            thread_id=start_thread, previous_profiler_present=previous is not None)
                  reason = "returned"
                  try:
                      return await Runner.run(agent, state, run_config=run_config)
                  except BaseException as exc:
                      reason = "exception:" + type(exc).__name__
                      raise
                  finally:
                      end_active = sys.getprofile() == self.profile
                      self.emit("TRACE_END", observer_active=end_active,
                                same_thread=threading.get_ident() == start_thread,
                                observer_errors=len(self.errors) - errors_before,
                                dropped_events=self.dropped - dropped_before,
                                unmatched_sync_calls=len(self.active_frames), reason=reason)
                      sys.setprofile(previous)
          
          
          def decision_action_snapshot(state, approved_a: bool, rejected_b: bool) -> dict:
              """Read no approval getter; record only what this harness explicitly decided.
          
              This is NOT proof of the SDK's readback. Genuine get_approval_status()
              calls are independently observed while the SDK resumes.
              """
              return {"A_action": "approve" if approved_a else "none",
                      "B_action": "reject" if rejected_b else "none",
                      "interruptions": sorted(getattr(x.raw_item, "call_id", None)
                                              for x in state.get_interruptions()),
                      "type": "HARNESS_ACTIONS_NOT_SDK_READBACK"}
          
          
          def interruptions(result) -> list[str | None]:
              return [getattr(item.raw_item, "call_id", None) for item in result.interruptions]
          
          
          async def run_case(case: str) -> dict:
              from agents import Agent, Runner, RunConfig
              from agents.decorators import tool
              from agents.testing import ScriptedModel, function_call, assistant_message
              from agents.tool_guardrails import (
                  tool_input_guardrail, tool_output_guardrail, ToolGuardrailFunctionOutput)
          
              nested = case != "DIRECT_REJECT"
              counts = {name: 0 for name in (
                  "executor_A", "effect_A", "executor_B", "effect_B",
                  "guardrail_input_A", "guardrail_output_A")}
              report = {"case": case, "events": [], "status": "NOT_EVALUABLE",
                        "decisions": {}, "exception": None, "after_A": None, "after_second": None}
              observer = Observer(case, report)
          
              def mark(name):
                  counts[name] += 1
                  observer.emit("SIDE_EFFECT", name=name)
          
              @tool_input_guardrail
              async def check_input(_):
                  mark("guardrail_input_A")
                  return ToolGuardrailFunctionOutput.allow()
          
              @tool_output_guardrail
              async def check_output(_):
                  mark("guardrail_output_A")
                  return ToolGuardrailFunctionOutput.allow()
          
              @tool(needs_approval=True, tool_input_guardrails=[check_input],
                    tool_output_guardrails=[check_output])
              async def action_a() -> str:
                  """Record harmless approved action A."""
                  mark("executor_A")
                  mark("effect_A")
                  return "receipt-A"
          
              @tool(needs_approval=True)
              async def action_b() -> str:
                  """Record harmless separate action B."""
                  mark("executor_B")
                  mark("effect_B")
                  return "receipt-B"
          
              child_model = ScriptedModel([
                  [function_call("action_a", {}, call_id="inner-A"),
                   function_call("action_b", {}, call_id="inner-B")],
                  [assistant_message("child done")],
              ])
              child = Agent(name="child", model=child_model, tools=[action_a, action_b])
              parent_model = None
              if nested:
                  parent_model = ScriptedModel([
                      [function_call("delegate", {"input": "run"}, call_id="outer-1")],
                      [assistant_message("parent done")],
                  ])
                  parent = Agent(name="parent", model=parent_model, tools=[
                      child.as_tool(tool_name="delegate", tool_description="Nested synthetic task",
                                    session=None, failure_error_function=None),
                  ])
              else:
                  parent = child
              cfg = RunConfig(tracing_disabled=True)
          
              try:
                  observer.phase = "FIRST"
                  first = await Runner.run(parent, "start", run_config=cfg)
                  report["first_pending"] = interruptions(first)
                  if sorted(report["first_pending"]) != ["inner-A", "inner-B"]:
                      raise AssertionError("Initial A/B pending identities not distinct")
                  state = first.to_state()
                  a = next(x for x in state.get_interruptions() if x.raw_item.call_id == "inner-A")
                  state.approve(a)
                  report["decisions"]["before_A"] = decision_action_snapshot(
                      state, approved_a=True, rejected_b=False)
                  if report["decisions"]["before_A"]["interruptions"] != ["inner-A", "inner-B"]:
                      raise AssertionError("Initial interrupted identities changed after A action")
                  report["decision_state_sha256"] = hashlib.sha256(
                      json.dumps(state.to_json(), sort_keys=True, default=str).encode()).hexdigest()
                  second = await observer.resume(parent, state, "RESUME_A", cfg)
                  report["after_A"] = {"pending": interruptions(second), "counts": dict(counts),
                                       "child_model_calls": len(child_model.calls)}
                  if interruptions(second) != ["inner-B"]:
                      raise AssertionError("B not sole remaining interruption")
                  state2 = second.to_state()
                  report["decisions"]["before_second"] = decision_action_snapshot(
                      state2, approved_a=True, rejected_b=False)
                  if case == "NESTED_NO_DECISION":
                      phase = "RESUME_NO_NEW_DECISION"
                  else:
                      b = next(x for x in state2.get_interruptions() if x.raw_item.call_id == "inner-B")
                      state2.reject(b, rejection_message="reviewer rejected B")
                      report["decisions"]["before_second"] = decision_action_snapshot(
                          state2, approved_a=True, rejected_b=True)
                      phase = "RESUME_REJECT_B"
                  third = await observer.resume(parent, state2, phase, cfg)
                  report["after_second"] = {"pending": interruptions(third), "counts": dict(counts),
                                            "final_output": third.final_output,
                                            "child_model_calls": len(child_model.calls)}
                  report["status"] = "OBSERVED"
              except Exception as error:
                  report["exception"] = {"type": type(error).__name__, "message": str(error),
                                         "phase": observer.phase, "traceback": traceback.format_exc()[-3000:]}
                  report["status"] = "NOT_EVALUABLE"
              report["observer_errors"] = observer.errors
              report["dropped_events"] = observer.dropped
              report["trace_valid_A"] = trace_valid(report, "RESUME_A")
              report["trace_valid_second"] = trace_valid(
                  report, "RESUME_NO_NEW_DECISION" if case == "NESTED_NO_DECISION" else "RESUME_REJECT_B")
              save_json(f"{case}.json", report)
              print("ATLAS_CASE", json.dumps({"case": case, "status": report["status"],
                                              "after_A": report["after_A"], "after_second": report["after_second"],
                                              "trace_valid_A": report["trace_valid_A"],
                                              "trace_valid_second": report["trace_valid_second"]}, sort_keys=True))
              return report
          
          
          def cause_chain(report: dict) -> dict:
              rows = [e for e in report["events"] if e["phase"] == "RESUME_A"]
              if not trace_valid(report, "RESUME_A"):
                  return {"status": "UNRESOLVED", "reason": "OBSERVER_INVALID"}
              gate_returns = [e for e in rows if e["event"] == "LOCAL_RETURN"
                              and e.get("function") == "_nested_interruptions_status"
                              and e.get("regular_value") is True and e.get("value") == "pending"
                              and e.get("call_id") == "outer-1"]
              for gate in gate_returns:
                  gate_decisions = [e for e in rows if e["event"] == "APPROVAL_READ"
                                    and e.get("caller_function") == "_nested_interruptions_status"
                                    and e.get("caller_invocation") == gate.get("invocation")
                                    and e.get("seq", 0) < gate["seq"]]
                  if not any(e.get("call_id") == "inner-A" and e.get("decision") is True
                             and e.get("return_type") == "bool" for e in gate_decisions):
                      continue
                  if not any(e.get("call_id") == "inner-B" and e.get("decision") is None
                             and e.get("return_type") == "NoneType" for e in gate_decisions):
                      continue
                  filters = [e for e in rows if e["event"] == "LOCAL_RETURN"
                             and e.get("function") == "_function_output_exists"
                             and e.get("regular_value") is True and e.get("value") is True
                             and e.get("call_id") == "outer-1"
                             and e.get("invocation") == gate.get("parent_invocation")
                             and e["seq"] > gate["seq"]]
                  for filtered in filters:
                      selector_id = filtered.get("selector_frame_id")
                      if selector_id is None:
                          continue
                      starts = [e for e in rows if e["event"] == "SELECTOR_ENTER"
                                and e.get("selector_frame_id") == selector_id
                                and "outer-1" in e.get("candidate_call_ids", [])
                                and e["seq"] < gate["seq"]]
                      inventory = [e for e in rows if e["event"] == "OUTER_OUTPUT_INDEX"
                                   and e.get("invocation") == filtered.get("invocation")
                                   and e.get("selector_frame_id") == selector_id
                                   and e.get("call_id") == "outer-1"
                                   and e.get("index_known") is True
                                   and e.get("actual_output_item_present") is False
                                   and e["seq"] < gate["seq"]]
                      if not starts or not inventory:
                          continue
                      excluded = [e for e in rows if e["event"] == "SELECTION_RESULT"
                                  and e.get("selector_frame_id") == selector_id
                                  and e["seq"] > filtered["seq"]
                                  and "outer-1" in e.get("candidate_call_ids", [])
                                  and "outer-1" not in e.get("selected_call_ids", [])]
                      if not excluded:
                          continue
                      entered_child = any(e["event"] == "RUNNER_ENTER" and e.get("agent") == "child"
                                          for e in rows)
                      if entered_child or report.get("after_A", {}).get("counts", {}).get("effect_A") != 0:
                          continue
                      return {"status": "SUPPORTED", "reason": "PENDING_FILTER_EXCLUDES_DELEGATE",
                              "call_id": "outer-1", "gate_event": gate["seq"],
                              "filter_event": filtered["seq"], "selection_event": excluded[0]["seq"],
                              "selector_enter_event": starts[0]["seq"],
                              "actual_output_index_event": inventory[0]["seq"],
                              "selector_frame_id": selector_id}
              return {"status": "UNRESOLVED", "reason": "CHAIN_NOT_OBSERVED"}
          
          
          async def run_all() -> int:
              tests = observer_selftest()
              save_json("observer_selftest.json", tests)
              runtime = runtime_identity()
              save_json("runtime.json", runtime)
              if not runtime["commit_match"]:
                  print("BLOCKED: loaded SDK commit mismatch", file=sys.stderr)
                  return 3
              records = {case: await run_case(case) for case in CASES}
              direct = records["DIRECT_REJECT"]
              nested = records["NESTED_REJECT"]
              no_decision = records["NESTED_NO_DECISION"]
              d_first = (direct.get("after_A") or {}).get("counts", {})
              n_first = (nested.get("after_A") or {}).get("counts", {})
              n_last = (nested.get("after_second") or {}).get("counts", {})
              controls_ok = (
                  direct["status"] == nested["status"] == "OBSERVED"
                  and direct["trace_valid_A"] and nested["trace_valid_A"] and nested["trace_valid_second"]
                  and d_first.get("effect_A") == 1
                  and n_last.get("effect_A") == 1
                  and d_first.get("effect_B", 0) == n_first.get("effect_B", 0) == n_last.get("effect_B", 0) == 0
                  and n_last.get("guardrail_input_A") == n_last.get("guardrail_output_A") == 1
                  and (nested.get("after_second") or {}).get("pending") == []
              )
              # The observer's ability to see child entry must be calibrated in the
              # positive rejection control before treating absence as causal evidence.
              child_entry_calibrated = any(e.get("event") == "RUNNER_ENTER"
                                           and e.get("agent") == "child"
                                           and e.get("phase") == "RESUME_REJECT_B"
                                           for e in nested["events"])
              chain = cause_chain(nested)
              isolated = all((r.get("after_A") or {}).get("counts", {}).get("effect_B", 0) == 0
                             and (r.get("after_second") or {}).get("counts", {}).get("effect_B", 0) == 0
                             for r in records.values())
              exactly_once = all((r.get("after_second") or {}).get("counts", {}).get("effect_A", 0) <= 1
                                 for r in records.values())
              no_decision_safe = no_decision["status"] == "OBSERVED" and (
                  no_decision.get("after_second") or {}).get("pending") == ["inner-B"]
              observed_gate = any(e.get("event") == "LOCAL_RETURN" and
                                  e.get("function") == "_nested_interruptions_status"
                                  for e in nested["events"])
              observed_filter = any(e.get("event") == "LOCAL_RETURN" and
                                    e.get("function") == "_function_output_exists"
                                    for e in nested["events"])
              observed_select = any(e.get("event") == "SELECTION_RESULT"
                                    for e in nested["events"] if e.get("phase") == "RESUME_A")
              if not isolated or not exactly_once:
                  verdict = "SECURITY_BOUNDARY_FAILURE_OR_DUPLICATE_EFFECT"
              elif not controls_ok or not child_entry_calibrated or not (observed_gate and observed_filter and observed_select):
                  verdict = "UNRESOLVED"
              elif n_first.get("effect_A") == 1:
                  verdict = "REFUTED_IN_THIS_RUN"
              elif chain["status"] == "SUPPORTED":
                  verdict = "SUPPORTED"
              else:
                  verdict = "UNRESOLVED"
              summary = {"schema": "atlas-f1f-v4.1", "sdk_commit": BASELINE,
                         "measurement_valid": controls_ok and observed_gate and observed_filter and observed_select,
                         "trace_complete": all(r["trace_valid_A"] for r in records.values()),
                         "approval_identity_valid": all(
                      r.get("decisions", {}).get("before_A", {}).get("A_action") == "approve"
                      and r.get("decisions", {}).get("before_A", {}).get("B_action") == "none"
                      for r in records.values()),
                  "decision_evidence_type": "HARNESS_ACTIONS_PLUS_SDK_RUNTIME_READS",
                  "B_isolated": isolated, "A_not_duplicated": exactly_once,
                  "no_decision_safe": no_decision_safe,
                  "no_decision_is_secondary": True,
                  "child_entry_calibrated_on_rejection": child_entry_calibrated,
                         "outer_status_observed": observed_gate,
                         "output_filter_observed": observed_filter,
                         "selection_exclusion_observed": chain["status"] == "SUPPORTED",
                         "delegate_entry_observed": any(e.get("event") == "RUNNER_ENTER" and
                                                         e.get("agent") == "child" and
                                                         e.get("phase") == "RESUME_A" for e in nested["events"]),
                         "A_effect_count": n_first.get("effect_A"),
                         "B_effect_count": n_first.get("effect_B"),
                         "hypothesis_verdict": verdict,
                         "mechanism_chain": chain,
                         "no_decision_second_resume_status": no_decision["status"],
                         "no_decision_trace_complete": no_decision["trace_valid_second"],
                         "observer_selftest": tests, "runtime": runtime,
                         "security_bug_confirmed": False}
              save_json("summary.json", summary)
              print("ATLAS_F1F_V4_1", json.dumps(summary, sort_keys=True))
              return 0 if verdict in ("SUPPORTED", "REFUTED_IN_THIS_RUN") else (1 if verdict == "SECURITY_BOUNDARY_FAILURE_OR_DUPLICATE_EFFECT" else 3)
          
          
          if __name__ == "__main__":
              if "--selftest" in sys.argv:
                  print(json.dumps(observer_selftest(), sort_keys=True))
              else:
                  raise SystemExit(asyncio.run(run_all()))
          ATLAS_F1F_V4_PROBE
          python -m py_compile probe.py
          python probe.py --selftest
          python probe.py
      - name: Record SHA-256 evidence manifest
        if: always()
        shell: bash
        run: |
          mkdir -p proof
          find proof -type f ! -name SHA256SUMS -print0 | sort -z | xargs -0 -r sha256sum > SHA256SUMS
          for file in probe.py sdk.txt dependencies.txt; do
            if [ -f "$file" ]; then sha256sum "$file" >> SHA256SUMS; fi
          done
      - name: Upload proof even if diagnostic outcome is unresolved
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: atlas-f1f-v4-observer-integrity
          path: |
            probe.py
            proof/
            sdk.txt
            dependencies.txt
            SHA256SUMS
          if-no-files-found: warn
